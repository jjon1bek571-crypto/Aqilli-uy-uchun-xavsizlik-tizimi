# ─────────────────────────────────────────────────────────────
# EarlyAlert — environment variables
# Copy this file to `.env.local` and fill in the values.
# The app runs fully in DEMO MODE even with everything blank.
# ─────────────────────────────────────────────────────────────

# ── AI (server-side only — NEVER exposed to the browser) ──────
# Used by the serverless functions in /api. Get a key at:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional model overrides (sensible defaults are used if blank)
GEMINI_MODEL_TEXT=gemini-2.5-flash
GEMINI_MODEL_IMAGE=gemini-2.5-flash-image
GEMINI_MODEL_LIVE=gemini-2.5-flash-native-audio-preview-09-2025

# ── Auth + Database (Supabase) ────────────────────────────────
# These are safe to expose to the browser (anon key is public by design,
# protected by Row Level Security). Create a free project at supabase.com
# and run supabase/schema.sql in the SQL editor.
# If left blank, the app uses a local demo account + seeded data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── App ───────────────────────────────────────────────────────
VITE_APP_NAME=EarlyAlert
